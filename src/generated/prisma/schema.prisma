generator client {
  provider = "prisma-client-js"
  output   = "."
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String               @id @default(cuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  createdAt       DateTime             @default(now())
  termsAcceptedAt DateTime?
  preferredDeck   String               @default("Rider-Waite")
  preferredReader String               @default("vespera")
  preferredLocale String               @default("en")
  accounts        Account[]
  sessions        Session[]
  readings        Reading[]
  subscription    Subscription?
  payments        Payment[]
  passwordResets  PasswordResetToken[]
}

/// Single-use password-reset grant. Only the SHA-256 of the token is stored —
/// the raw value exists solely in the emailed link, so a DB leak can't reset anyone.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Reading {
  id        String   @id @default(cuid())
  userId    String
  cards     String[]
  response  String   @db.Text
  /// User-assigned label for the reading; null until they name it.
  title     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PlanId {
  FREE
  SINGLE
  MONTHLY
  YEARLY
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    PlanId    @default(FREE)
  startedAt DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  monoInvoiceId String?
  monoCardToken String?
  paymentStatus String?
  lastChargedAt DateTime?
  nextChargeAt  DateTime?

  pendingPlanId      String? // what the user is currently trying to buy: "SINGLE"|"MONTHLY"|"YEARLY"
  readingCredits     Int     @default(0) // consumable one-off extra readings
  activatedInvoiceId String? // the invoiceId whose "success" we already applied (idempotency guard)

  autoRenew            Boolean   @default(true) // false = cancel at period end
  canceledAt           DateTime? // when the user turned off auto-renew
  renewalAttempts      Int       @default(0) // dunning retry counter for the current cycle; reset to 0 on success
  lastRenewalAttemptAt DateTime? // spaces retries to once per day
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monoInvoiceId String   @unique // one ledger row per Mono invoice
  reference     String? // our correlation reference
  productType   String // "SINGLE" | "MONTHLY" | "YEARLY" (what was bought)
  amount        Int // minor units (cents)
  currency      String   @default("EUR")
  status        String // last known: created/processing/success/failure/reversed
  maskedPan     String? // from webhook paymentInfo.maskedPan when present
  paymentSystem String? // visa/mastercard, from webhook when present
  failureReason String? // from webhook when present
  cardToken     String? // walletData.cardToken when present
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
