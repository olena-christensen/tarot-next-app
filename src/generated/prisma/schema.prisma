generator client {
  provider = "prisma-client-js"
  output   = "."
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String                   @id @default(cuid())
  name               String?
  email              String?                  @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  createdAt          DateTime                 @default(now())
  termsAcceptedAt    DateTime?
  preferredDeck      String                   @default("Rider-Waite")
  preferredReader    String                   @default("vespera")
  preferredLocale    String                   @default("en")
  /// Opt-in for the daily card email. Off by default — nobody is enrolled without asking.
  /// Entitlement is re-checked at send time, so a lapsed subscriber stops receiving it
  /// without this flag changing.
  dailyCardEmail     Boolean                  @default(false)
  /// UTC day (YYYY-MM-DD) of the last daily card sent, or null. Guards against a
  /// second send: the deterministic pick keeps a rerun on the same card, but only
  /// this stops it going out twice.
  dailyCardSentOn    String?
  /// Opt-in for the "you haven't drawn in a while" nudge. Off by default.
  readingReminder    Boolean                  @default(false)
  /// UTC day (YYYY-MM-DD) of the last reminder sent, or null. Enforces the
  /// once-a-week floor — the job runs daily, the nudge must not.
  reminderSentOn     String?
  accounts           Account[]
  sessions           Session[]
  readings           Reading[]
  subscription       Subscription?
  payments           Payment[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
}

/// One counter per throttled thing (an email address, an IP, a form).
///
/// Deliberately NOT tied to User: most of what needs throttling is unauthenticated,
/// and an attempt against an address that doesn't exist still has to be counted —
/// otherwise "did this row appear" becomes an account-enumeration oracle.
model RateLimit {
  /// Namespaced subject, e.g. "login:email:a@b.c" or "register:ip:1.2.3.4".
  key          String    @id
  /// Attempts inside the current window.
  count        Int       @default(0)
  /// When the current counting window ends.
  windowEndsAt DateTime
  /// Set once the limit is exceeded; null while under it.
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([windowEndsAt])
}

/// Single-use email-verification grant. Same shape as PasswordResetToken and for
/// the same reason: only the SHA-256 is stored, so a leaked DB row can't be turned
/// back into a usable link.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use password-reset grant. Only the SHA-256 of the token is stored —
/// the raw value exists solely in the emailed link, so a DB leak can't reset anyone.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Reading {
  id         String   @id @default(cuid())
  userId     String
  cards      String[]
  response   String   @db.Text
  /// User-assigned label for the reading; null until they name it.
  title      String?
  /// User's own annotation — what actually happened. Null until they write one.
  note       String?  @db.Text
  /// Starred for retrieval; the ledger can filter to these.
  isFavorite Boolean  @default(false)
  /// Which reader's voice produced this reading. Null on rows written before
  /// 2026-08-02, and for anything whose reader can't be resolved.
  readerId   String?
  /// Which deck the cards were drawn from, so a shared/printed reading always
  /// renders the art the user actually saw — not their current preference.
  deckId     String?
  /// Public share token. Null = not shared; setting it publishes the reading at
  /// /{locale}/r/{shareId}, clearing it revokes that link immediately.
  shareId    String?  @unique
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PlanId {
  FREE
  SINGLE
  MONTHLY
  YEARLY
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    PlanId    @default(FREE)
  startedAt DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  monoInvoiceId String?
  monoCardToken String?
  paymentStatus String?
  lastChargedAt DateTime?
  nextChargeAt  DateTime?

  pendingPlanId      String? // what the user is currently trying to buy: "SINGLE"|"MONTHLY"|"YEARLY"
  readingCredits     Int     @default(0) // consumable one-off extra readings
  activatedInvoiceId String? // the invoiceId whose "success" we already applied (idempotency guard)

  autoRenew            Boolean   @default(true) // false = cancel at period end
  canceledAt           DateTime? // when the user turned off auto-renew
  renewalAttempts      Int       @default(0) // dunning retry counter for the current cycle; reset to 0 on success
  lastRenewalAttemptAt DateTime? // spaces retries to once per day
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monoInvoiceId String   @unique // one ledger row per Mono invoice
  reference     String? // our correlation reference
  productType   String // "SINGLE" | "MONTHLY" | "YEARLY" (what was bought)
  amount        Int // minor units (cents)
  currency      String   @default("EUR")
  status        String // last known: created/processing/success/failure/reversed
  maskedPan     String? // from webhook paymentInfo.maskedPan when present
  paymentSystem String? // visa/mastercard, from webhook when present
  failureReason String? // from webhook when present
  cardToken     String? // walletData.cardToken when present
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
